# Pola untuk 205 vault, 211 music, 213 sso, 214 immich:
# hanya lewat Tailscale Serve, tidak ada port layanan di LAN. Simpan sebagai /etc/pve/firewall/ID.fw
[OPTIONS]
enable: 1
policy_in: DROP
policy_out: ACCEPT
dhcp: 1

[RULES]
IN ACCEPT -source +dc/admin -p tcp -dport 22
IN ACCEPT -source 192.168.88.20 -p tcp -dport PORT-AGEN-BESZEL
IN ACCEPT -p icmp
