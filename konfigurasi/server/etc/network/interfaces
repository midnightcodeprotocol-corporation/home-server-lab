# Proxmox host, ThinkCentre M710q. Ganti enp0s31f6 sesuai hasil: ip -br link
auto lo
iface lo inet loopback

iface enp0s31f6 inet manual
    post-up /usr/sbin/ethtool -s enp0s31f6 wol g   # Wake-on-LAN (Bab 30.5)

auto vmbr0
iface vmbr0 inet static
    address 192.168.88.10/24
    gateway 192.168.88.1
    bridge-ports enp0s31f6
    bridge-stp off
    bridge-fd 0

source /etc/network/interfaces.d/*
