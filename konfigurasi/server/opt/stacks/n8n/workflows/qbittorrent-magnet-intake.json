    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = String($input.first()?.json?.magnet ?? '').trim();\nif (!raw || raw.length > 4096) throw new Error('Magnet kosong atau melebihi 4096 karakter.');\nif (/\\s|[\\u0000-\\u001f\\u007f]/.test(raw)) throw new Error('Magnet mengandung spasi atau karakter kontrol.');\nlet parsed;\ntry { parsed = new URL(raw); } catch { throw new Error('Format magnet tidak valid.'); }\nif (parsed.protocol !== 'magnet:') throw new Error('Hanya URI magnet yang diterima.');\nconst validHash = parsed.searchParams.getAll('xt').some(value => /^urn:btih:(?:[a-f0-9]{40}|[a-z2-7]{32})$/i.test(value));\nif (!validHash) throw new Error('Magnet harus memiliki hash BitTorrent BTIH yang valid.');\nreturn [{ json: { magnet: raw } }];"
      },
      "id": "baa6923a-f8be-4138-aa03-4dcdfeb8b16c",
      "name": "Validasi magnet BTIH",
      "type": "n8n-nodes-base.code",
